# ============================================================
# لمسة جمال — Beauty POS — OFFLINE Version
# ============================================================
# This version runs 100% offline. NO Supabase required.
# All data is stored locally in SQLite (pos.db).
#
# The only env var needed is for local Prisma dev (optional):
# ============================================================

# --- Local dev database (SQLite — used by Prisma for `prisma db push`) ---
# Only needed if you want to run `prisma db push` or `prisma/seed.ts` locally.
# The desktop app (Tauri) creates its own pos.db automatically.
DATABASE_URL="file:./db/dev.db"

# --- App config (optional — all have safe defaults) ---
NEXT_PUBLIC_APP_NAME="لمسة جمال"
NEXT_PUBLIC_CURRENCY="EGP"
NEXT_PUBLIC_LANGUAGE="ar"

# ============================================================
# NOTE: This is the OFFLINE version. There are NO Supabase vars.
# The sync engine is disabled. All data stays local.
# For the cloud-sync version, see:
#   https://github.com/mathatqra-arch/beauty-pos-lamsa-jamal
# ============================================================
